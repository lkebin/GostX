services:
  # Type tungo service is required
  - name: vpn
    handler:
      type: tungo
      chain: upstream

chains:
  - name: upstream
    hops:
      - name: hop0
        nodes:
          - name: server
            addr: example.com
            connector:
              type: ss
              metadata:
                method: chacha20-ietf-poly1305
                password: password
            dialer:
              type: tcp


# --- Split tunnel through WireGuard -----------------------------------------
#
# Targets covered by the whitelisted bypass go through the WireGuard peer;
# everything else bypasses the chain and is dialed directly (the app protects
# its own sockets, so direct traffic does not loop back into the TUN).
#
# bypasses:
#   - name: wg-ips
#     whitelist: true
#     matchers:
#       - 10.8.0.0/16
#       - 192.168.9.13
# chains:
#   - name: vpn-chain-wg
#     hops:
#       - name: wg-hop
#         bypass: wg-ips
#         nodes:
#           - name: wg-node
#             dialer:
#               type: wg
#               metadata:
#                 privateKey: "<client private key, base64>"
#                 peerPublicKey: "<server public key, base64>"
#                 endpoint: wg.example.com:51820
#                 localIPs: 10.7.0.2/32
#                 # allowedIPs defaults to 0.0.0.0/0; keep it that way and let
#                 # the bypass decide what enters the tunnel.
#                 mtu: 1420
#                 keepalive: 25s
#             connector:
#               type: wg
# services:
#   - name: vpn
#     handler:
#       type: tungo
#       chain: vpn-chain-wg
